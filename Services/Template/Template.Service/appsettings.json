{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=microservices_template;Username=postgres;Password=postgrespassword",
    "Redis": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "Identity": {
    "Issuer": "https://identity.local",
    "Audience": "microservices",
    "JwksUri": "http://localhost:5001/.well-known/jwks.json"
  },
  "Service": {
    "Name": "template-service",
    "Version": "1.0.0"
  },
  "RateLimiting": {
    "AnonymousPerMinute": 60,
    "AuthenticatedPerMinute": 300,
    "StrictPerMinute": 20
  }
}
